<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KioskOsWizard.ViewModels"
             x:DataType="vm:ConfigStepViewModel"
             x:Class="KioskOsWizard.Views.ConfigStepView">
    <StackPanel Spacing="20" MaxWidth="560">
        <!-- Homepage -->
        <StackPanel Spacing="6">
            <TextBlock Text="Homepage URL" Foreground="White" FontWeight="SemiBold"/>
            <TextBlock Text="The page the kiosk will show at all times"
                       Foreground="#888" FontSize="12"/>
            <TextBox Text="{Binding Homepage}"
                     Watermark="https://your-app.com"
                     Background="#1a1a2e" Foreground="White"
                     BorderBrush="#2a2a3e" Padding="10,8"/>
        </StackPanel>

        <!-- Browser Mode -->
        <StackPanel Spacing="6">
            <TextBlock Text="Browser mode" Foreground="White" FontWeight="SemiBold"/>
            <RadioButton Content="Kiosk — no UI, fully locked down"
                         IsChecked="{Binding BrowserModeKiosk}"
                         Foreground="#ddd" GroupName="Browser"/>
            <RadioButton Content="Fullscreen — with back button and toolbar"
                         IsChecked="{Binding !BrowserModeKiosk}"
                         Foreground="#ddd" GroupName="Browser"/>
        </StackPanel>

        <!-- Whitelist -->
        <StackPanel Spacing="6">
            <TextBlock Text="Domain whitelist (optional)" Foreground="White" FontWeight="SemiBold"/>
            <TextBlock Text="Pipe-separated list. Only these domains will load."
                       Foreground="#888" FontSize="12"/>
            <TextBox Text="{Binding Whitelist}"
                     Watermark="example.com|api.example.com"
                     Background="#1a1a2e" Foreground="White"
                     BorderBrush="#2a2a3e" Padding="10,8"/>
        </StackPanel>

        <!-- Network -->
        <StackPanel Spacing="6">
            <TextBlock Text="Network" Foreground="White" FontWeight="SemiBold"/>
            <CheckBox Content="Use WiFi" IsChecked="{Binding UseWifi}"
                      Foreground="#ddd"/>
            <StackPanel Spacing="8" Margin="24,4,0,0"
                        IsVisible="{Binding UseWifi}">
                <TextBox Text="{Binding WifiSsid}"
                         Watermark="WiFi network name (SSID)"
                         Background="#1a1a2e" Foreground="White"
                         BorderBrush="#2a2a3e" Padding="10,8"/>
                <TextBox Text="{Binding WifiPassword}" PasswordChar="•"
                         Watermark="WiFi password (empty for an open network)"
                         Background="#1a1a2e" Foreground="White"
                         BorderBrush="#2a2a3e" Padding="10,8"/>
            </StackPanel>
        </StackPanel>

        <!-- Timezone -->
        <StackPanel Spacing="6">
            <TextBlock Text="Timezone" Foreground="White" FontWeight="SemiBold"/>
            <TextBox Text="{Binding Timezone}"
                     Watermark="Europe/Berlin"
                     Background="#1a1a2e" Foreground="White"
                     BorderBrush="#2a2a3e" Padding="10,8"/>
        </StackPanel>

        <!-- Keyboard layout -->
        <StackPanel Spacing="6">
            <TextBlock Text="Keyboard layout" Foreground="White" FontWeight="SemiBold"/>
            <TextBlock Text="The layout of the keyboard attached to the kiosk"
                       Foreground="#888" FontSize="12"/>
            <ComboBox ItemsSource="{Binding KeyboardLayoutOptions}"
                      SelectedItem="{Binding KeyboardLayout}"
                      HorizontalAlignment="Stretch"
                      Background="#1a1a2e" Foreground="White"
                      BorderBrush="#2a2a3e" Padding="10,8"/>
        </StackPanel>

        <!-- Installation -->
        <StackPanel Spacing="6">
            <TextBlock Text="Installation" Foreground="White" FontWeight="SemiBold"/>
            <CheckBox Content="Install kiosk-os on the internal disk of the kiosk PC"
                      IsChecked="{Binding InstallToDisk}" Foreground="#ddd"/>
            <TextBlock Text="On first boot the stick shows an installer that copies kiosk-os, including this configuration, onto the internal disk. Without this option the kiosk runs from the stick."
                       Foreground="#888" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>

        <TextBlock Text="{Binding ValidationMessage}"
                   IsVisible="{Binding ValidationMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                   Foreground="#f59e0b" TextWrapping="Wrap"/>
    </StackPanel>
</UserControl>
