<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KioskOsWizard.ViewModels"
             x:DataType="vm:WelcomeStepViewModel"
             x:Class="KioskOsWizard.Views.WelcomeStepView">
    <StackPanel Spacing="16" MaxWidth="560">
        <TextBlock Text="Set up a new kiosk"
                   FontSize="24" FontWeight="SemiBold"
                   Foreground="White"/>
        <TextBlock TextWrapping="Wrap" Foreground="#bbb" LineHeight="22"
                   Text="This wizard will guide you through creating a bootable kiosk-os USB stick. The process takes about 3–5 minutes."/>

        <StackPanel Spacing="12" Margin="0,16,0,0">
            <TextBlock Text="What you'll need:" FontWeight="SemiBold" Foreground="White"/>
            <TextBlock Foreground="#aaa" Text="• A USB stick (8 GB minimum)"/>
            <TextBlock Foreground="#aaa" Text="• The kiosk-os ISO file (download at github.com/LennartKleymann/kiosk-os)"/>
            <TextBlock Foreground="#aaa" Text="• The URL you want to show on the kiosk"/>
        </StackPanel>

        <Border Background="#1e1e38" BorderBrush="#3a3a5e" BorderThickness="1"
                CornerRadius="8" Padding="16" Margin="0,16,0,0">
            <StackPanel Spacing="4">
                <TextBlock Text="⚠  Administrator privileges required"
                           FontWeight="SemiBold" Foreground="#f59e0b"/>
                <TextBlock TextWrapping="Wrap" Foreground="#cca0a0"
                           Text="Writing to a USB stick requires elevated permissions. You may be prompted for your password during the flashing step."/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
