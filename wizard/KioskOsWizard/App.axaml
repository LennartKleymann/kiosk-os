<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="KioskOsWizard.App"
             xmlns:local="using:KioskOsWizard"
             RequestedThemeVariant="Dark">
             <!-- Always dark: the views are designed for a dark background with white
                  text. Following a light Windows theme made focused text boxes white
                  on white. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>